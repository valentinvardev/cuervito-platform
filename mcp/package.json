{
  "name": "encontrate-ops-mcp",
  "version": "1.2.0",
  "private": true,
  "description": "MCP remoto de sólo lectura con métricas agregadas y salud técnica de encontrate.app",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probar": "tsx scripts/probar.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1139.0",
    "@aws-sdk/client-cost-explorer": "^3.1139.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
