# ── Obligatorias ────────────────────────────────────────────────────────────

# Conexión a Postgres (Supabase). Recomendado: el rol de sólo lectura del
# README, no el usuario de la aplicación. Sirve la URL del pooler.
DATABASE_URL="postgresql://mcp_lectura:CAMBIAR@HOST:6543/postgres"

# El token que mandan los clientes en Authorization: Bearer <token>.
# Mínimo 32 caracteres. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=""

# ── Opcionales ──────────────────────────────────────────────────────────────

# PORT=8787
# METRICS_TZ=America/Argentina/Buenos_Aires   # "hoy" y "esta semana" en esta zona
# DATABASE_SSL=require                         # off | require | verify
# DB_STATEMENT_TIMEOUT_MS=8000                 # tope por consulta
# RATE_LIMIT_PER_MIN=60                        # pedidos por minuto con el token
# AUTH_FAILURES_PER_MIN=20                     # intentos fallidos por minuto y por IP
# MIN_GROUP_SIZE=5                             # compras mínimas para informar un monto
# TRUST_PROXY=true                             # detrás de nginx, Railway o Fly

# CloudWatch: sólo si hay alarmas armadas. Con las dos, get_health informa las
# que estén en ALARM. Credenciales por las variables estándar de AWS o por el
# rol de la máquina; el permiso que hace falta es cloudwatch:DescribeAlarms.
# AWS_REGION=us-east-2
# CLOUDWATCH_ALARM_PREFIX=encontrate-
